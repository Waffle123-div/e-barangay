{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{views,templates}/**",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/((?!css/|js/|images/|favicon\\.ico|robots\\.txt).*)",
      "destination": "/api/index.js"
    }
  ]
}
