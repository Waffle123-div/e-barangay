# Application
NODE_ENV=development
PORT=3000
APP_NAME="E-Barangay"
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-hex-secret
SESSION_LIFETIME=120

# Supabase PostgreSQL (Use Transaction Pooler URL in Vercel, e.g. port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Project (Storage + Realtime)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=ebarangay-files

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Email (Resend HTTP, Mailjet v3.1 HTTP, or SMTP)
MAIL_MAILER=mailjet_http
MAIL_FROM_ADDRESS=cogoneast.system@gmail.com
MAIL_FROM_NAME="E-Barangay Cogon East"
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS (Textbee)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Google reCAPTCHA v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Gemini AI (Istong Assistant)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq AI (Optional fallback for Istong Assistant)
GROQ_API_KEY=
